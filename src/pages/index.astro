---
import Board from "../components/Board.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const title = "LilSuperUser";
const description =
    "FOSS | Linux | Systems Programming | Reverse Engineering & Exploit Development";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <title>{title}</title>
    </head>
    <body>
        <main>
            <section class="board-zone">
                <Board />
            </section>
            <aside class="panel-zone" hidden></aside>
        </main>
        <Footer />
    </body>
</html>

<style>
    main {
        height: calc(100vh - var(--footer-height));
        background: var(--page-bg);
        color: var(--board-silkscreen);
        font-family: var(--font-board);
        text-align: center;
    }

    .board-zone {
        height: 100%;
        padding: 1.5rem;
        background-image: radial-gradient(
            rgba(216, 212, 196, 0.07) 1px,
            transparent 1px
        );
        background-size: 20px 20px;
    }
</style>
