---
import { round } from "../../lib/board/router";

// 2.54 mm is the standard header pitch
const pitch = 2.54;

// Left edge of the uart housing in the group's mm: the whole uart moves with this
const uartX = 37.5;

// every row of posts as [first post x, y, count], in the group's mm
const rows: [number, number, number][] = [
    [2.77, 3.18, 10], // jtag, top row (odd pins)
    [2.77, 5.72, 10], // jtag, bottom row (even pins)
    [uartX + 1.27, 4.45, 4], // uart
];

// a row of square posts is one dashed line: the dash is the post
// (0.64 mm square) and dash + gap is the pitch. the line starts half a
// dash before the first post's centre so every dash lands on a post
const postLine = (x0: number, y: number, count: number, grow: number) =>
    `M${round(x0 - grow)} ${round(y)}H${round(x0 + (count - 1) * pitch + grow)}`;

const posts = rows.map(([x, y, n]) => postLine(x, y, n, 0.32)).join("");
const sides = rows.map(([x, y, n]) => postLine(x, y + 0.2, n, 0.32)).join("");
const sheen = rows.map(([x, y, n]) => postLine(x, y, n, 0.15)).join("");

const uartPins = ["GND", "TX", "RX", "3V3"];
---

<g id="debug" transform="translate(300 186)">
    <path class="silk-outline" d="M-2.2 -1.2H31.8V10.1H-3.4V0Z" />
    <path
        class="silk-outline"
        d={`M${uartX} 1.98H${round(uartX + 11.36)}V6.92H${round(uartX - 1.2)}V3.18Z`}
    />

    <text class="silk" x="14.2" y="-2.6" text-anchor="middle">
        JTAG
    </text>
    <text class="hdr-num" x="-1.7" y="3.8" text-anchor="middle">
        1
    </text>
    <text class="hdr-num" x="-1.7" y="6.3" text-anchor="middle">
        2
    </text>
    <text class="hdr-num" x="30.1" y="3.8" text-anchor="middle">
        19
    </text>
    <text class="hdr-num" x="30.1" y="6.3" text-anchor="middle">
        20
    </text>

    <text class="silk" x={round(uartX + 5.08)} y="0.4" text-anchor="middle">
        UART
    </text>
    {uartPins.map((name, i) => (
        <text
            class="hdr-label"
            transform={`translate(${round(uartX + 1.27 + i * pitch - 0.55)} 8) rotate(90)`}
        >
            {name}
        </text>
    ))}

    <path class="hdr-body" d="M1 0H28.4V8.9H0V1Z" />
    <rect class="hdr-cavity" x="1" y="1" width="26.4" height="6.9" />
    <rect class="hdr-ledge" x="1.6" y="1.6" width="25.2" height="5.7" />
    <rect class="hdr-key" x="12.2" y="7.9" width="4" height="1.3" />

    <path
        class="hdr-body"
        d={`M${round(uartX + 0.8)} 3.18H${round(uartX + 10.16)}V5.72H${uartX}V3.98Z`}
    />

    <path class="hdr-side" d={sides} />
    <path class="hdr-post" d={posts} />
    <path class="hdr-sheen" d={sheen} />
</g>

<style>
    .hdr-num,
    .hdr-label {
        fill: var(--board-silkscreen);
        opacity: 0.55;
        font-family: var(--font-board);
    }

    .hdr-num {
        font-size: 1.8px;
    }

    .hdr-label {
        font-size: 1.6px;
    }

    .hdr-body {
        fill: var(--board-chip);
        stroke: var(--board-chip-outline);
        stroke-width: 0.4;
    }

    .hdr-cavity {
        fill: var(--page-bg);
    }

    .hdr-ledge {
        fill: none;
        stroke: var(--board-chip-outline);
        stroke-width: 0.25;
    }

    .hdr-key {
        fill: var(--board-surface);
    }

    .hdr-side,
    .hdr-post {
        fill: none;
        stroke-width: 0.64;
        stroke-dasharray: 0.64 1.9;
    }

    .hdr-side {
        stroke: var(--board-steel-dark);
    }

    .hdr-post {
        stroke: var(--board-tin);
    }

    .hdr-sheen {
        fill: none;
        stroke: var(--board-silkscreen);
        stroke-width: 0.3;
        stroke-dasharray: 0.3 2.24;
        opacity: 0.6;
    }
</style>
