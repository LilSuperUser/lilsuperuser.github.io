---
// Decoupling caps: 0603 mlccs (1.6 x 0.8 mm) ringed around the socket
// the right side stops short of y=106 to leave room for the socket lever
const caps: { x: number; y: number; vertical: boolean }[] = [];

for (let x = 144; x <= 196; x += 4) {
    caps.push({ x, y: 70, vertical: false });
    caps.push({ x, y: 130, vertical: false });
}
for (let y = 80; y <= 120; y += 4) caps.push({ x: 137, y, vertical: true });
for (let y = 78; y <= 106; y += 4) caps.push({ x: 204, y, vertical: true });

const round = (n: number) => Math.round(n * 100) / 100;
const rectPath = (x: number, y: number, w: number, h: number) =>
    `M${round(x)} ${round(y)}h${round(w)}v${round(h)}h${round(-w)}z`;

// Every part of every cap goes into one of three path strings,
// so 100+ caps cost only three svg elements
let capPads = "";
let capBodies = "";
let capEnds = "";

for (const { x, y, vertical } of caps) {
    const w = vertical ? 0.8 : 1.6;
    const h = vertical ? 1.6 : 0.8;
    const x0 = x - w / 2;
    const y0 = y - h / 2;
    capBodies += rectPath(x0, y0, w, h);

    // The two metal terminations, one at each end of the body
    const ends = vertical
        ? [
              [x0, y0, w, 0.4],
              [x0, y0 + h - 0.4, w, 0.4],
          ]
        : [
              [x0, y0, 0.4, h],
              [x0 + w - 0.4, y0, 0.4, h],
          ];

    for (const [ex, ey, ew, eh] of ends) {
        capEnds += rectPath(ex, ey, ew, eh);
        // The copper pad is the termination plus a 0.15 mm margin
        capPads += rectPath(ex - 0.15, ey - 0.15, ew + 0.3, eh + 0.3);
    }
}
---

<g id="decoupling">
    <path class="cap-pad" d={capPads} />
    <path class="cap-body" d={capBodies} />
    <path class="cap-end" d={capEnds} />
</g>

<style>
    .cap-pad {
        fill: var(--board-gold);
        opacity: 0.45;
    }

    .cap-body {
        fill: var(--board-mlcc);
    }

    .cap-end {
        fill: var(--board-silkscreen);
        opacity: 0.8;
    }
</style>
