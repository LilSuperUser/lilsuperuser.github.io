---
import ConnectorShell from "./ConnectorShell.astro";
---

<g id="usb" transform="translate(-0.8 80)">
    <path class="silk-outline" d="M0.8 -3H18.3L19.3 -2V16.4L18.3 17.4H0.8" />
    <text class="silk" x="10" y="-4.7" text-anchor="middle">
        USB
    </text>

    <g class="usb-trident" transform="translate(13.5 21.5) scale(-1 1)">
        <path class="usb-trident-line" d="M0 0H8M3 0L4.4 -1.8H6.2M5 0L6.2 1.8" />
        <path
            class="usb-trident-shape"
            d="M-0.8 0a0.8 0.8 0 1 0 1.6 0a0.8 0.8 0 1 0 -1.6 0zM8 -0.9L9.8 0L8 0.9zM6.2 -1.8a0.6 0.6 0 1 0 1.2 0a0.6 0.6 0 1 0 -1.2 0zM6.2 1.2h1.2v1.2h-1.2z"
        />
    </g>

    <ConnectorShell depth={17.5} width={14.5} />
</g>

<style>
    .usb-trident {
        opacity: 0.5;
    }

    .usb-trident-line {
        fill: none;
        stroke: var(--board-silkscreen);
        stroke-width: 0.35;
        stroke-linecap: round;
    }

    .usb-trident-shape {
        fill: var(--board-silkscreen);
    }
</style>
