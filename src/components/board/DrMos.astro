---
interface Props {
    x: number;
    y: number;
}

const { x, y } = Astro.props;
---

<g transform={`translate(${x} ${y})`}>
    <rect class="mos-body" x="-3" y="-3" width="6" height="6" />
    <circle class="mos-dot" cx="-2.1" cy="-2.1" r="0.4" />
    <text class="mos-mark" y="-0.1" text-anchor="middle">
        LSU
    </text>
    <text class="mos-mark" y="1.5" text-anchor="middle">
        90A
    </text>
</g>

<style>
    .mos-body {
        fill: var(--board-package);
        stroke: var(--board-chip-outline);
        stroke-width: 0.25;
    }

    .mos-dot {
        fill: var(--board-silkscreen);
        opacity: 0.7;
    }

    .mos-mark {
        fill: var(--board-silkscreen);
        opacity: 0.5;
        font-family: var(--font-board);
        font-size: 1.3px;
    }
</style>
