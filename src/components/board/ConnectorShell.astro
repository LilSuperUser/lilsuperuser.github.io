---
import { round } from "../../lib/board/router";

// A steel connector shell (from above), drawn in the parent's local coordinates:
//NOTE: The front is at x=0, depth along x, & width along y
interface Props {
    depth: number;
    width: number;
    rim?: number; // Length of the black plastic back (mm)
    emboss?: boolean; // The big stamped panel on the top face
}

const { depth, width, rim = 1, emboss = true } = Astro.props;

// Where the metal top ends and the plastic back begins
const metalEnd = round(depth - rim - 0.7);

// Through-hole shield pads, just outside each long side of the shell
const padXs = [round(depth * 0.23), round(depth * 0.74)];
const pads = padXs.flatMap((x) => [`M${x} -1.4h0`, `M${x} ${round(width + 1.4)}h0`]).join("");
---

<path class="tht-pad" d={pads} />
<path class="tht-drill" d={pads} />

<rect class="shell" x="0" y="0" width={depth} height={width} rx="0.5" />
<path class="shell-sheen-hi" d={`M1.2 1.2H${metalEnd}`} />
<path class="shell-sheen-lo" d={`M1.2 ${round(width - 1.2)}H${metalEnd}`} />
{emboss && (
    <rect class="shell-emboss" x="6" y="3" width={round(depth - 9.5)} height={width - 6} rx="0.6" />
)}
<rect class="shell-dimple" x="1.6" y="3" width="2.6" height="1" rx="0.5" />
<rect class="shell-dimple" x="1.6" y={width - 4} width="2.6" height="1" rx="0.5" />
<path class="shell-seam" d={`M${metalEnd} 0.5V${round(width - 0.5)}`} />
<rect class="shell-lip" x="0" y="0" width="0.8" height={width} rx="0.4" />
<rect class="shell-rim" x={depth - rim} y="0" width={rim} height={width} rx="0.3" />
<slot />

<style>
    .tht-pad {
        stroke: var(--board-gold);
        stroke-width: 1.8;
        stroke-linecap: round;
    }

    .tht-drill {
        stroke: var(--page-bg);
        stroke-width: 0.7;
        stroke-linecap: round;
    }

    .shell {
        fill: var(--board-steel);
        stroke: var(--board-steel-dark);
        stroke-width: 0.4;
    }

    .shell-sheen-hi {
        fill: none;
        stroke: var(--board-silkscreen);
        stroke-width: 0.3;
        opacity: 0.35;
    }

    .shell-sheen-lo {
        fill: none;
        stroke: var(--board-steel-dark);
        stroke-width: 0.3;
    }

    .shell-emboss {
        fill: none;
        stroke: var(--board-steel-dark);
        stroke-width: 0.35;
    }

    .shell-dimple {
        fill: var(--board-steel-dark);
    }

    .shell-seam {
        fill: none;
        stroke: var(--board-steel-dark);
        stroke-width: 0.3;
    }

    .shell-lip {
        fill: var(--board-steel-dark);
    }

    .shell-rim {
        fill: var(--board-chip);
    }
</style>
