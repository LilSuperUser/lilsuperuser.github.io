---
const width = 460;
const height = 210;

// mounting hole centers in mm
const holes = [
    [8, 8],
    [452, 8],
    [8, 202],
    [452, 202],
];

// dimm slot geometry in mm
// (real ddr5 slots are 133.35 long)
const ramLabels = ["A1", "A2", "B1", "B2"];
// const ramLabels = ["A1", "A2"];  // Experimental 4 slots
const ramX = 225;
const ramY = 38;
const ramPitch = 10;
const slotLength = 133.35;

const ram = ramLabels.map((label, i) => ({ label, x: ramX + i * ramPitch }));

// decoupling caps: 0603 mlccs (1.6 x 0.8 mm) ringed around the socket
// the right side stops short of y=106 to leave room for the socket lever
const caps: { x: number; y: number; vertical: boolean }[] = [];

for (let x = 144; x <= 196; x += 4) {
    caps.push({ x, y: 70, vertical: false });
    caps.push({ x, y: 130, vertical: false });
}
for (let y = 80; y <= 120; y += 4) caps.push({ x: 137, y, vertical: true });
for (let y = 78; y <= 106; y += 4) caps.push({ x: 204, y, vertical: true });

const round = (n: number) => Math.round(n * 100) / 100;
const rectPath = (x: number, y: number, w: number, h: number) =>
    `M${round(x)} ${round(y)}h${round(w)}v${round(h)}h${round(-w)}z`;

// every part of every cap goes into one of three path strings,
// so 100+ caps cost three svg elements
let capPads = "";
let capBodies = "";
let capEnds = "";

for (const { x, y, vertical } of caps) {
    const w = vertical ? 0.8 : 1.6;
    const h = vertical ? 1.6 : 0.8;
    const x0 = x - w / 2;
    const y0 = y - h / 2;
    capBodies += rectPath(x0, y0, w, h);

    // the two metal terminations, one at each end of the body
    const ends = vertical
        ? [
              [x0, y0, w, 0.4],
              [x0, y0 + h - 0.4, w, 0.4],
          ]
        : [
              [x0, y0, 0.4, h],
              [x0 + w - 0.4, y0, 0.4, h],
          ];

    for (const [ex, ey, ew, eh] of ends) {
        capEnds += rectPath(ex, ey, ew, eh);
        // the copper pad is the termination plus a 0.15 mm margin
        capPads += rectPath(ex - 0.15, ey - 0.15, ew + 0.3, eh + 0.3);
    }
}
---

<svg viewBox={`-1 -1 ${width + 2} ${height + 2}`} role="img" aria-label="Illustrated motherboard">
    <rect class="substrate" x="0" y="0" width={width} height={height} rx="4" />
    {holes.map(([x, y]) => (
        <circle class="hole" cx={x} cy={y} r="3.2" />
    ))}

    <defs>
        <pattern id="lga" width="1.4" height="1.4" patternUnits="userSpaceOnUse">
            <circle class="lga-dot" cx="0.7" cy="0.7" r="0.3" />
        </pattern>
    </defs>

    <g id="cpu">
        <rect class="socket-frame" x="142" y="74" width="56" height="52" rx="2" />
        <rect class="socket-lands" x="148" y="80" width="44" height="40" />
        <rect class="socket-plate" x="146" y="78" width="48" height="44" rx="1" />
        <path class="socket-pin1" d="M142 74 h7 l-7 7 z" />
        <path class="socket-lever" d="M198 112 h10 v14 h-6" />
    </g>

    <g id="decoupling">
        <path class="cap-pad" d={capPads} />
        <path class="cap-body" d={capBodies} />
        <path class="cap-end" d={capEnds} />
    </g>

    <g id="ram">
        {ram.map(({ label, x }) => (
            <g>
                <rect class="slot-body" x={x} y={ramY} width="7" height={slotLength} rx="1" />
                <rect
                    class="slot-channel"
                    x={x + 2}
                    y={ramY + 3}
                    width="3"
                    height={slotLength - 6}
                />
                <line
                    class="slot-contacts"
                    x1={x + 3.5}
                    y1={ramY + 4}
                    x2={x + 3.5}
                    y2={ramY + slotLength - 4}
                />
                <rect class="slot-key" x={x + 2} y={ramY + 60} width="3" height="1.4" />
                <rect class="slot-latch" x={x} y={ramY - 6} width="7" height="6" rx="1" />
                <rect class="slot-latch-tab" x={x + 2} y={ramY - 4} width="3" height="2" />
                <text class="silk" x={x + 3.5} y={ramY + slotLength + 5} text-anchor="middle">
                    {label}
                </text>
            </g>
        ))}
    </g>
</svg>

<style>
    svg {
        width: 100%;
        height: 100%;
    }

    .substrate {
        fill: var(--board-surface);
        stroke: var(--board-edge);
        stroke-width: 0.6;
    }

    .hole {
        fill: var(--page-bg);
        stroke: var(--board-edge);
        stroke-width: 0.6;
    }

    .lga-dot,
    .socket-pin1 {
        fill: var(--board-gold);
    }

    .socket-frame {
        fill: var(--board-chip);
        stroke: var(--board-chip-outline);
        stroke-width: 0.5;
    }

    .socket-lands {
        fill: url(#lga);
    }

    .socket-plate {
        fill: none;
        stroke: var(--board-chip-outline);
        stroke-width: 0.8;
    }

    .socket-lever {
        fill: none;
        stroke: var(--board-chip-outline);
        stroke-width: 1.2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .slot-body {
        fill: var(--board-chip);
        stroke: var(--board-chip-outline);
        stroke-width: 0.4;
    }

    .slot-channel {
        fill: var(--page-bg);
    }

    .slot-contacts {
        stroke: var(--board-gold);
        stroke-width: 2;
        stroke-dasharray: 0.5 0.35;
    }

    .slot-key {
        fill: var(--board-chip);
    }

    .slot-latch {
        fill: var(--board-chip-outline);
    }

    .slot-latch-tab {
        fill: var(--board-chip);
    }

    .silk {
        fill: var(--board-silkscreen);
        opacity: 0.55;
        font-family: var(--font-board);
        font-size: 2.6px;
    }

    .cap-pad {
        fill: var(--board-gold);
        opacity: 0.45;
    }

    .cap-body {
        fill: var(--board-mlcc);
    }

    .cap-end {
        fill: var(--board-silkscreen);
        opacity: 0.8;
    }
</style>
